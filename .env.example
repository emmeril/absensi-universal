# Alamat HTTPS yang dapat dibuka dari ponsel anggota.
# Wajib untuk fitur kamera karena browser memblokir kamera pada HTTP biasa.
PUBLIC_BASE_URL=https://absensi.organisasi.example

# Port HTTP lokal. Ubah jika port 3200 sudah dipakai aplikasi lain.
PORT=3200

# Nomor admin pertama untuk instalasi baru. Setelah database terisi, pengelolaan
# admin dilakukan dari dashboard dan nilai ini tidak mengembalikan admin terhapus.
INITIAL_ADMIN_NUMBER=6281234567890
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=ganti-dengan-password-kuat

# Jumlah reverse proxy tepercaya di depan Express. Biarkan 0 jika tanpa proxy.
TRUST_PROXY_HOPS=0

# Otomatis aktif jika PUBLIC_BASE_URL memakai HTTPS.
SESSION_COOKIE_SECURE=true

# Zona waktu yang dipakai untuk tanggal dan jam absensi.
TZ=Asia/Jakarta

# Direktori sesi Baileys. Di dalamnya tersimpan satu sesi untuk setiap nomor
# pengelola unit. Jangan bagikan atau commit direktori ini.
BAILEYS_AUTH_DATA_PATH=./.baileys_auth
# Level log internal Baileys: silent, error, warn, info, debug, atau trace.
WA_LOG_LEVEL=silent
# Opsional: paksa versi protokol jika pengambilan otomatis sedang bermasalah.
# WA_WEB_VERSION=2.3000.1047437723

# Lokasi database SQLite. Biarkan nilai ini untuk penyimpanan standar.
DB_PATH=./data/absensi.sqlite

# Pengaturan antrean dan worker verifikasi wajah.
FACE_WORKER_COUNT=1
FACE_QUEUE_LIMIT=100
FACE_ESTIMATED_JOB_MS=2500
# Deadline total sejak request masuk, termasuk waktu menunggu antrean.
FACE_TIMEOUT_MS=60000
FACE_SLOW_LOG_MS=10000
FACE_REFERENCE_CACHE_LIMIT=500
FACE_TINY_INPUT_SIZE=320
FACE_TINY_SCORE_THRESHOLD=0.45

# Outbox notifikasi disimpan di SQLite dan dilanjutkan otomatis setelah restart.
NOTIFICATION_OUTBOX_CONCURRENCY=4
NOTIFICATION_OUTBOX_POLL_MS=2000
NOTIFICATION_RETRY_BASE_DELAY_MS=15000
NOTIFICATION_RETRY_MAX_DELAY_MS=900000
NOTIFICATION_MAX_ATTEMPTS=12
NOTIFICATION_SENT_RETENTION_MS=604800000
# Proteksi pengiriman otomatis. `automatic` direkomendasikan dan tidak perlu
# pengaturan tambahan; mode `conservative` memperlambat ritme untuk akun baru.
WA_SEND_SAFETY_MODE=automatic
# Pengaturan lanjutan di bawah ini opsional. Biarkan terkomentar agar nilainya
# mengikuti mode otomatis yang dipilih.
# WA_SEND_MIN_INTERVAL_MS=1000
# WA_SEND_MAX_INTERVAL_MS=2200
# WA_SEND_RECIPIENT_INTERVAL_MS=3500
# WA_SEND_MAX_PER_MINUTE=30
# WA_SEND_QUEUE_LIMIT=500
# WA_SEND_FAILURE_THRESHOLD=5
# WA_SEND_FAILURE_COOLDOWN_MS=120000
# Retry hanya dijalankan jika pengiriman gagal. Jeda memakai exponential backoff
# dengan jitter agar percobaan ulang tidak membentuk burst yang sama.
WA_SEND_MAX_RETRIES=3
WA_SEND_RETRY_BASE_DELAY_MS=5000
WA_SEND_RETRY_MAX_DELAY_MS=60000
WA_SEND_RETRY_JITTER_RATIO=0.35
